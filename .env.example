# --- Required -----------------------------------------------------------
YOUTUBE_API_KEY=            # Google Cloud console -> YouTube Data API v3 (daily discovery only)
ANTHROPIC_API_KEY=          # console.anthropic.com

# --- Storage ------------------------------------------------------------
DATABASE_URL=sqlite:///data/ytstock.db   # or postgresql+psycopg://user:pass@host/db
REPORTS_DIR=reports
SOURCES_FILE=configs/sources.yaml

# --- Discovery ----------------------------------------------------------
MARKET_TIMEZONE=America/New_York
TOP_N_VIDEOS=10
MIN_DURATION_SECONDS=180
MAX_DURATION_SECONDS=7200
MIN_VIEW_COUNT=1000

# --- Transcripts --------------------------------------------------------
# YouTube blocks caption requests from most cloud IPs. Use one of:
YT_PROXY_URL=               # e.g. http://user:pass@host:port
WEBSHARE_PROXY_USERNAME=
WEBSHARE_PROXY_PASSWORD=
WHISPER_FALLBACK=false      # needs `uv sync --extra whisper` + ffmpeg
WHISPER_MODEL=base.en

# --- Claude -------------------------------------------------------------
CLAUDE_MODEL=claude-opus-5
CLAUDE_VIDEO_EFFORT=medium
CLAUDE_SYNTHESIS_EFFORT=high
CLAUDE_FACTCHECK_EFFORT=high
CLAUDE_BRIEF_EFFORT=xhigh
CLAUDE_FALLBACKS=true       # server-side refusal fallbacks (beta)
FACTCHECK_MAX_SEARCHES=12
BRIEF_MAX_SEARCHES=10
ANALYSIS_CONCURRENCY=3

# --- Logging ------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT=console          # console | json
